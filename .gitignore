node_modules/
dist/

# Per-machine state: the program catalog, launch counts and the generated
# helper scripts. Regenerated on first run.
data/

# Generated from build/icon.png by electron-builder.
build/icon.ico

# Trace preview, regenerated by `npm run trace-glyphs`.
tools/glyph-preview.svg

# Distributable bundle staged by hand.
release/
*.zip

# Reference clip from the show, used only to design the console. Not needed
# to build, and not ours to redistribute.
assets/*.mp4

# Demo clips, regenerated by `node tools/record-demo.js`. Deliverables for
# sharing, not repo content - GitHub renders video from release assets or a
# drag-and-drop upload, not from a relative path.
stargate-*.mp4
