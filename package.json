{
  "name": "stargate-launcher",
  "productName": "Stargate Command",
  "version": "1.2.1",
  "license": "MIT",
  "description": "An app launcher that dials your programs like an SG-1 Stargate",
  "author": "David Weisberg",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "serve": "node server.js",
    "dist": "electron-builder --win --publish never --config.electronDist=node_modules/electron/dist",
    "pack": "electron-builder --win --dir --publish never --config.electronDist=node_modules/electron/dist",
    "dist:linux": "electron-builder --linux --publish never",
    "pack:linux": "electron-builder --linux --dir --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "pack:mac": "electron-builder --mac --dir --publish never",
    "trace-glyphs": "node tools/trace-glyphs.js assets/glyphs.png --region 228,196,772,812 --circle 623,623,535 --cols 6 --rows 7 --preview",
    "release": "node tools/make-release.js"
  },
  "build": {
    "appId": "com.davidweisberg.stargatecommand",
    "productName": "Stargate Command",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "lib/**/*",
      "public/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "StargateCommand-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stargate Command"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "stargate-command",
      "artifactName": "Stargate-Command-${version}.${ext}"
    },
    "appImage": {
      "compression": "gzip"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utility",
      "icon": "build/icon.png",
      "artifactName": "Stargate-Command-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "identity": null,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Stargate-Command-${version}-${arch}.${ext}"
    },
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "afterPack": "build/after-pack.js"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
